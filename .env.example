# IBKR Gateway Connection Settings (Read-Only)
# Use 127.0.0.1 when running natively via `make run`
# docker-compose.yml automatically overrides IBKR_HOST to host.docker.internal
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=77

# Market Data Mode: DELAYED (Type 3 -> Type 4) or LIVE (Type 1 -> Type 2)
# Overriding DEFAULT_MARKET_DATA_TYPE (1..4) auto-aligns mode/fallback unless overridden explicitly
MARKET_DATA_MODE=DELAYED
DEFAULT_MARKET_DATA_TYPE=3
FALLBACK_MARKET_DATA_TYPE=4

# Quantitative Fallback Settings
RISK_FREE_RATE=0.0425

# Web Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Hybrid Options Trade Ledger (Optional / Read-Only)
# Keep your IBKR Flex Web Service token strictly in .env (never commit real tokens).
IBKR_FLEX_TOKEN=
# 365-day full Activity Flex Query ID (used for initial backfill / full sync)
IBKR_FLEX_ACTIVITY_QUERY_ID=
# Optional lighter 30-day/monthly Activity Flex Query ID placeholder (used for incremental syncs once history exists)
IBKR_FLEX_MONTHLY_QUERY_ID=
# Optional intraday Trade Confirmation Flex Query ID (appended when configured)
IBKR_FLEX_TRADE_CONF_QUERY_ID=
# Explicit opt-in for read-only Gateway reqExecutionsAsync / reqPositionsAsync sync (default false)
ENABLE_GATEWAY_LEDGER_SYNC=false
GATEWAY_LEDGER_INCLUDE_STOCK=true
LEDGER_ROLL_MAX_GAP_HOURS=24.0
LEDGER_DIR=data/ledger